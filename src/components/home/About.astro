---
import { Image } from 'astro:assets';
import photo from '../../assets/salsa-photo.jpg';
import { SITE } from '../../config';
---

<section class="panel about" id="about" data-spec="about" aria-labelledby="about-h">
  <div class="wrap about-grid">
    <div class="lanyard" aria-hidden="true">
      <svg class="strap" viewBox="0 0 200 230">
        <path d="M40 -400C60 60 80 150 96 214" stroke="#000" stroke-opacity=".07" stroke-width="22" fill="none" stroke-linecap="round"></path>
        <path d="M170 -400C158 70 134 150 110 214" stroke="#E2DDD0" stroke-width="18" fill="none" stroke-linecap="round"></path>
        <path d="M36 -400C56 60 76 150 94 214" stroke="#FFFFFF" stroke-width="18" fill="none" stroke-linecap="round"></path>
        <path d="M36 -400C56 60 76 150 94 214" stroke="#DFF67E" stroke-width="3" fill="none"></path>
        <rect x="93" y="206" width="16" height="24" rx="4" fill="#B2B8C0"></rect><circle cx="101" cy="226" r="9" fill="none" stroke="#9AA0A8" stroke-width="3"></circle>
      </svg>
      <div class="id-card">
        <Image src={photo} alt="" widths={[300, 600]} sizes="272px" />
        <span class="shine"></span>
        <div class="id-tag"><div><b>{SITE.name}</b>{SITE.role}</div><em>PASS</em></div>
      </div>
    </div>

    <div class="about-text">
      <p class="eyebrow">01 / About me <span class="pass">✓ PASSED</span></p>
      <h2 class="h2" id="about-h" data-split>Hi, I’m <em class="serif">Salsa</em></h2>
      <p class="lead" data-reveal>I’m a QA engineer with a software development background. I started as a developer — <strong>Laravel, React, React Native</strong> — before moving into QA. Knowing how apps are built helps me design sharper test cases, find defects faster, and talk clearly with the people who fix them.</p>
      <p class="lead" data-reveal>Today I focus on <strong>manual and API testing</strong> — functional, regression, smoke and UAT, with clear test cases and bug reports — plus performance and load testing with k6 and mobile testing with Appium. I’ve also learned the basics of test automation with Katalon Studio, Playwright and JMeter.</p>
      <p class="lead" data-reveal>I’ve trained users and travel partners on how to use the product, and turned their feedback into improvements. I’m studying Information Systems at BINUS, and open to QA and test automation opportunities.</p>
      <div class="stats">
        <div class="stat" data-reveal><b data-count="3" data-suffix="+">3+</b><span>years in software</span></div>
        <div class="stat" data-reveal><b data-count="1" data-suffix="+">1+</b><span>years focused on QA</span></div>
        <div class="stat" data-reveal><b data-count="6">6</b><span>certifications</span></div>
        <div class="stat" data-reveal><b data-count="3">3</b><span>testing layers: UI, API, load</span></div>
      </div>
    </div>
  </div>
</section>
