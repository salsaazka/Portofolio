---
interface Props {
  name: 'linkedin' | 'whatsapp' | 'arrow';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

{name === 'linkedin' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10.5v6M8 7.6v.01M12 16.5v-6M12 13c0-1.7 1.2-2.5 2.5-2.5S17 11.3 17 13v3.5"></path></svg>
)}
{name === 'whatsapp' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 8 19.3z"></path><path d="M9 8.6c.2 2.6 3.2 5.6 5.9 5.9l1.2-1.4-1.9-1-.9.8c-1-.4-2-1.4-2.4-2.4l.8-.9-1-1.9z" fill="currentColor" stroke-width="1"></path></svg>
)}
{name === 'arrow' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8.5 7H17v8.5"></path></svg>
)}
